# ---------------------------------------------------
# Unreal Engine .gitignore
# ---------------------------------------------------

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Rider
*.iml

# Compiled source
*.o
*.obj
*.exe
*.dll
*.lib
*.pdb
*.exp

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Cache files
*.uasset.bak
*.umap.bak

# OS generated files
.DS_Store
Thumbs.db

# UE4/UE5 generated folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Plugin generated folders
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Benchmark run outputs
BenchmarkResults/

# Rider / VS project files (regenerated by UE)
*.VC.db
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# Android/iOS/Console specific build artifacts
*.apk
*.ipa

# Miscellaneous
*.tmp
*.log
